// Units (TYPE 9): literals, arithmetic, conversions, display.
EXPORT UWEIGHT(w)
BEGIN
  RETURN STRING(w*1_lbf/1_ft,2,1,0);
END;
EXPORT UBORE(d)
BEGIN
  RETURN " d = "+STRING(d*1_inch,2,3);
END;
EXPORT USUM()
BEGIN
  LOCAL a:=20_cm;
  a:=a+5_inch;
  RETURN a;
END;
//> 2_m => 2_m
//> TYPE(2_m) => 9
//> TYPE(1_ m) => 9
//> 1_(MPa) => 1_MPa
//> 10_ft^2 => 10_ft^2
